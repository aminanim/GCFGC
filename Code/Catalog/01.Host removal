THREADS=16
 
# Input
RAW_READS="raw_reads.fastq.gz"
HOST_REF="host_reference.fna.gz"
 
# Output
OUTPUT_DIR="host_removal_output"
ALIGNED_SAM="${OUTPUT_DIR}/aligned.sam"
UNMAPPED_BAM="${OUTPUT_DIR}/unmapped.bam"
FILTERED_READS="${OUTPUT_DIR}/reads_without_host.fastq.gz"
 
 
# ---------------- Host read removal (minimap2 / samtools) ----------------
mkdir -p "$OUTPUT_DIR"
 
minimap2 -t "$THREADS" -ax map-ont "$HOST_REF" "$RAW_READS" > "$ALIGNED_SAM"
samtools view --threads "$THREADS" -b -f 4 "$ALIGNED_SAM" > "$UNMAPPED_BAM"
samtools fastq --threads "$THREADS" "$UNMAPPED_BAM" | gzip > "$FILTERED_READS"
