THREADS=16
 
# Input
GENE_CATALOG="gene_catalog.fasta"
ONT_READS="ont_reads.fastq.gz"
 
# Output
OUT_DIR="gene_catalog_abundance"
OUT_PREFIX="${OUT_DIR}/gene_catalog_vs_ont_reads"
 
# CoverM settings
MAPPER="minimap2-ont"
METRICS="tpm mean"
 
 
# ---------------- Gene catalog abundance quantification (CoverM) ----------------
mkdir -p "$OUT_DIR"
 
coverm contig \
    --reference "$GENE_CATALOG" \
    --single "$ONT_READS" \
    -p "$MAPPER" \
    -m $METRICS \
    --threads "$THREADS" \
    --output-file "${OUT_PREFIX}_abundance.tsv"
