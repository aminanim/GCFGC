THREADS=16

# Input
GENE_CATALOG="hanwoo_nonredun_gene_catalog.fasta"
ONT_READS="/10Gdata/amina/metagenome_data/nanopore_110_metagenomes/Minion_promethion_merged_without_host_for_rel_abun/minion_promethion_without_host_merged.fastq.gz"

# Output
OUT_DIR="protein_abundance_quantification"
OUT_PREFIX="${OUT_DIR}/hanwoo_geneCatalog_vs_ONTmerged_nohost"

# CoverM settings
MAPPER="minimap2-ont"
METRICS="tpm mean"


# ---------------- Gene catalog abundance quantification (CoverM) ----------------
mkdir -p "$OUT_DIR"

coverm contig \
    --reference "$GENE_CATALOG" \
    --single "$ONT_READS" \
    -p "$MAPPER" \
    -m $METRICS \
    --threads "$THREADS" \
    --output-file "${OUT_PREFIX}_abundance.tsv"
